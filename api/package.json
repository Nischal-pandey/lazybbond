{
  "name": "@lazybond/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @lazybond/database",
    "dev": "node --env-file=../.env --import tsx --watch src/server.ts",
    "build": "npm run build --workspace @lazybond/database && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @lazybond/database && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/validators.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@lazybond/database": "0.1.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
